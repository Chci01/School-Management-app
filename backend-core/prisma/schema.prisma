generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id               String   @id @default(uuid())
  name             String
  email            String?  @unique
  isActive         Boolean  @default(true)
  licenseKey       String?
  licenseExpiresAt DateTime?
  theme            String   @default("light")
  logo             String?
  slogan           String?
  address          String?
  phone            String?
  website          String?
  primaryColor     String?
  defaultLanguage  String?  @default("fr")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  academicYears    AcademicYear[]
  classes          Class[]
}

model User {
  id        String   @id @default(uuid())
  schoolId  String
  matricule String   @unique
  email     String?  @unique
  password  String
  firstName String
  lastName  String
  role      String   // ADMIN_SYSTEM, ADMIN_ECOLE, TEACHER, STUDENT, PARENT
  
  // Champs de Profil
  phone        String?
  address      String?
  gender       String?   // M, F
  dateOfBirth  DateTime?
  placeOfBirth String?
  photo        String?   // URL de la photo d'identité
  
  // Spécifique aux Professeurs
  expertise    String?   // Matières enseignées (ex: "Maths, Physique")
  
  // Spécifique aux élèves
  classId      String?
  parentName   String?
  parentPhone  String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id])
}

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   // e.g., "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id])
  classes   Class[]
}

model Class {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String?
  name           String
  level          String   // e.g., "6ème", "9ème", "Terminale"
  capacity       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School        @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
}
